PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=modoshop_db

# Redis (local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis (producción - Upstash). Si está definida, tiene prioridad sobre HOST/PORT
REDIS_URL=
# TTL del carrito en segundos (24 horas)
REDIS_TTL_CART=86400

# MongoDB (logs de actividad)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/modoshop_logs

# JWT
JWT_SECRET=secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=24h

# Pagos (simulado — no es una key real)
STRIPE_SECRET_KEY=sk_test_simulado_no_usar_en_produccion
PAYMENT_WEBHOOK_SECRET=whsec_simulado
# Probabilidad de éxito del simulador de pagos (0 a 1). 0.9 = 90 %
PAYMENT_SUCCESS_RATE=0.9
# Latencia simulada de la pasarela en ms
PAYMENT_LATENCY_MS=500

# CORS (orígenes separados por coma, * = todos)
CORS_ORIGIN=*
